// Realizar un algoritmo en pseudocódigo que lea tres números. Calcule e imprima la suma, el producto y el promedio de estos.
Algoritmo banco
	Definir inversion Como Entero
	Escribir 'ingresa la cantidad a invertir:'
	Leer inversion
	Definir rendimiento Como Real
	rendimiento <- inversion*0.02
	Escribir 'te inversion sera de:', rendimiento
FinAlgoritmo
