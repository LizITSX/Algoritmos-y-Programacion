// Una tienda ofrece un descuento del 15  MOD  sobre el total de la compra y un cliente desea saber cua?nto debera? pagar finalmente por esta.
Algoritmo tienda
	Definir precio, descuento Como Real
	Escribir 'Ingresa el precio sin desceunto del total de la compra:'
	Leer precio
	descuento <- precio*.75
	Escribir 'El total a pagar con descuento es:', descuento
FinAlgoritmo
