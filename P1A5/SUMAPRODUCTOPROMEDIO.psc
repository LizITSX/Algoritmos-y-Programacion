// Realizar un algoritmo en pseudocódigo que lea tres números. Calcule e imprima la suma, el producto y el promedio de estos.
Algoritmo SumaProductoPromedio
	Definir num1, num2, num3 Como Entero
	Definir suma, producto Como Entero
	Definir promedio Como Real
	Escribir 'Ingresa tu valor 1:'
	Leer num1
	Escribir 'Ingresa el valor 2:'
	Leer num2
	Escribir 'Ingresa el valor 3:'
	Leer num3
	suma <- num1+num2+num3
	producto <- num1*num2*num3
	promedio <- suma/3
	Escribir 'la suma es:', suma
	Escribir 'El promedio es:', promedio
	Escribir 'El producto es:', producto
FinAlgoritmo
